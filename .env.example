# Absolute paths only — this file is read directly, ~ and $HOME are not expanded.

# Local dev (12 GB card): serve the AWQ checkpoint. BF16 needs 16.4 GB of
# weights and will not fit. On the rented card, point MODEL at the BF16 copy
# and keep MODEL_AWQ for the comparison.
MODEL=/home/CHANGEME/models/qwen3-8b-awq
MODEL_AWQ=/home/CHANGEME/models/qwen3-8b-awq
EMBED_MODEL=/home/CHANGEME/models/bge-m3
RERANK_MODEL=/home/CHANGEME/models/bge-reranker

HF_TOKEN=
VLLM_URL=http://localhost:8000/v1
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# 0.85 on a card that also drives a desktop — the desktop holds ~900 MiB and
# drifts as windows open. Measured: the board sits at 11926/12282 MiB with the
# desktop up, so 0.90 does not fit. Raise toward 0.92 on a dedicated GPU.
GPU_MEM_UTIL=0.85

# WSL2 only. Drop both on the rented card, which has a real CUDA toolkit.
#   pin memory: works around a UVA crash under WSL2
#   flashinfer sampler: its kernels JIT-compile and need nvcc, which WSL2 does
#   not provide (driver only, no /usr/local/cuda). build-essential gives Triton
#   a C compiler but not nvcc. Disabling routes to the native torch sampler.
#   NOTE: this makes the sampler differ between hosts — record it per run.
VLLM_WSL2_ENABLE_PIN_MEMORY=1
VLLM_USE_FLASHINFER_SAMPLER=0
