# Absolute paths only — this file is read directly, ~ and $HOME are not expanded.

# Local dev (12 GB card): serve the AWQ checkpoint. BF16 needs 16.4 GB of
# weights and will not fit. On the rented card, point MODEL at the BF16 copy
# and keep MODEL_AWQ for the comparison.
MODEL=/home/CHANGEME/models/qwen3-8b-awq
MODEL_AWQ=/home/CHANGEME/models/qwen3-8b-awq
EMBED_MODEL=/home/CHANGEME/models/bge-m3
RERANK_MODEL=/home/CHANGEME/models/bge-reranker

HF_TOKEN=
VLLM_URL=http://localhost:8000/v1
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# 0.85 on a card that also drives a desktop — the desktop holds ~900 MiB and
# drifts as windows open. Raise toward 0.92 on a dedicated GPU.
GPU_MEM_UTIL=0.85
